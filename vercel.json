{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/generate",
      "destination": "/api/index"
    },
    {
      "source": "/crawl",
      "destination": "/api/index"
    },
    {
      "source": "/upload",
      "destination": "/api/index"
    },
    {
      "source": "/((?!.*\\.(?:html|css|js|png|jpg|ico|svg|json)$).*)",
      "destination": "/api/index"
    }
  ]
}
